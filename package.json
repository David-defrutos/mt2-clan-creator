{
  "name": "mt2-clan-creator",
  "version": "0.1.0-beta.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/creator-server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && node scripts/build-catalog-search.mjs && vite build",
    "start": "node dist-server/creator-server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "package:editor": "npm run package:creator",
    "check:i18n": "node scripts/check-i18n.mjs",
    "package:creator": "npm run build && node scripts/package-creator.mjs"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "description": "Guided Monster Train 2 clan creator for beginners using Trainworks and Conductor"
}
